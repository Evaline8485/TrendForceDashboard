        },
        {
          "handle": "jukan05",
          "platform": "X",
          "text": "Samsung’s strike has effectively come to an end. May the blessing of semiconductors be with the great Republic of Korea.  Thank you for your attention to this matter",
          "url": "https://x.com/jukan05/status/2057102732331450530",
